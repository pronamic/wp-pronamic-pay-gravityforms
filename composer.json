{
	"name": "wp-pay-extensions/gravityforms",
	"description": "Gravity Forms driver for the WordPress payment processing library.",
	"keywords": [
		"wordpress",
		"wp",
		"pay",
		"gravityforms",
		"extension",
		"pronamic"
	],
	"homepage": "http://www.wp-pay.org/extensions/gravityforms/",
	"license": "GPL-3.0-or-later",
	"type": "wordpress-plugin",
	"authors": [
		{
			"name": "Pronamic",
			"email": "info@pronamic.eu",
			"homepage": "http://www.pronamic.eu/",
			"role": "Company"
		},
		{
			"name": "Remco Tolsma",
			"email": "info@remcotolsma.nl",
			"homepage": "http://www.remcotolsma.nl/",
			"role": "Developer"
		}
	],
	"support": {
		"email": "support@wp-pay.org",
		"issues": "https://github.com/wp-pay-extensions/gravityforms/issues",
		"source": "https://github.com/wp-pay-extensions/gravityforms"
	},
	"autoload": {
		"psr-4": {
			"Pronamic\\WordPress\\Pay\\Extensions\\GravityForms\\": "src/"
		}
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"roots/wordpress-core-installer": true,
			"phpstan/extension-installer": true,
			"automattic/jetpack-autoloader": true
		},
		"platform": {
			"php": "8.3"
		},
		"platform-check": false,
		"sort-packages": true
	},
	"extra": {
		"installer-paths": {
			"packages/{$vendor}/{$name}": [
				"pronamic/wp-datetime",
				"pronamic/wp-gravityforms-nl",
				"pronamic/wp-html",
				"pronamic/wp-http",
				"pronamic/wp-money",
				"pronamic/wp-number",
				"vendor:wp-pay",
				"vendor:wp-pay-extensions",
				"woocommerce/action-scheduler"
			],
			"vendor/{$vendor}/{$name}/": [
				"wp-plugin/sqlite-database-integration"
			]
		},
		"wp-slug": "pronamic-pay-gravity-forms"
	},
	"repositories": [
		{
			"name": "wp-packages",
			"type": "composer",
			"url": "https://repo.wp-packages.org",
			"only": [
				"wp-plugin/*",
				"wp-theme/*"
			]
		}
	],
	"require": {
		"php": ">=8.3",
		"automattic/jetpack-autoloader": "^3.0 || ^4.0 || ^5.0 || ^6.0",
		"composer/installers": "^2.3",
		"pronamic/ideal-issuers": "^1.1",
		"pronamic/wp-datetime": "^2.2",
		"pronamic/wp-gravityforms-nl": "^3.0",
		"pronamic/wp-money": "^2.5",
		"pronamic/wp-number": "^1.4",
		"pronamic/wp-pay-logos": "^2.3",
		"woocommerce/action-scheduler": "^3.9 || ^4.0",
		"wp-pay/core": "^4.35"
	},
	"require-dev": {
		"php-coveralls/php-coveralls": "^2.9",
		"phpmd/phpmd": "^2.15",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.3",
		"phpunit/phpunit": "^10.5",
		"pronamic/gravityforms": "^3.2",
		"pronamic/wp-coding-standards": "^2.5",
		"rector/rector": "^2.8",
		"roots/wordpress": "^6.9",
		"solvebeam/wp-hooks-documentor": "^1.5",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"vimeo/psalm": "^6.0",
		"wp-cli/dist-archive-command": "^3.1",
		"wp-cli/wp-cli-bundle": "^2.12",
		"wp-phpunit/wp-phpunit": "^7.1",
		"wp-plugin/sqlite-database-integration": "^3.1",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"scripts": {
		"build": [
			"rm -rf ./build/stage-1",
			"rsync --recursive --verbose --exclude-from=.distignore --exclude=/vendor/ ./ ./build/stage-1/",
			"composer install --no-dev --prefer-dist --optimize-autoloader --working-dir=./build/stage-1/",
			"rsync --recursive --delete --delete-excluded --verbose --exclude-from=.distignore ./build/stage-1/ ./build/pronamic-pay-gravity-forms/",
			"vendor/bin/wp i18n make-pot ./build/pronamic-pay-gravity-forms/ --slug=pronamic-pay-gravity-forms",
			"vendor/bin/wp i18n make-mo ./build/pronamic-pay-gravity-forms/languages/",
			"vendor/bin/wp dist-archive ./build/pronamic-pay-gravity-forms/ --plugin-dirname=pronamic-pay-gravity-forms --force"
		],
		"make-pot": [
			"@build",
			"rsync --recursive --delete --verbose ./build/pronamic-pay-gravity-forms/languages/ ./languages/",
			"vendor/bin/wp i18n update-po ./languages/pronamic-pay-gravity-forms.pot"
		],
		"coverage": "XDEBUG_MODE=coverage vendor/bin/phpunit --coverage-clover build/logs/clover.xml --coverage-text",
		"coveralls": "vendor/bin/php-coveralls -v",
		"phpcbf": "XDEBUG_MODE=off vendor/bin/phpcbf",
		"phpcs": "XDEBUG_MODE=off vendor/bin/phpcs -s -v",
		"phplint": "find src tests -name '*.php' | xargs -n 1 -P 4 php -l",
		"phpmd": "vendor/bin/phpmd src,tests text phpmd.ruleset.xml --suffixes php",
		"phpstan": "vendor/bin/phpstan analyse --memory-limit=-1",
		"phpunit": "vendor/bin/phpunit",
		"psalm": "vendor/bin/psalm",
		"build-docs": [
			"vendor/bin/wphd parse src --format=markdown --relative=docs > docs/hooks.md"
		]
	}
}
